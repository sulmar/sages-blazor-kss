@* Trasa strony pogody. *@
@page "/weather"
@* Klient HTTP wstrzyknięty z DI — wołania idą z przeglądarki. *@
@inject HttpClient Http

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>This component demonstrates fetching data from the server.</p>

@* null — dane jeszcze nie zostały pobrane. *@
@if (forecasts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Temp. (C)</th>
                <th>Temp. (F)</th>
                <th>Summary</th>
            </tr>
        </thead>
        <tbody>
            @* Jeden wiersz na każdą prognozę z JSON. *@
            @foreach (var forecast in forecasts)
            {
                <tr>
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td>@forecast.TemperatureC</td>
                    <td>@forecast.TemperatureF</td>
                    <td>@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // Tablica prognoz; null do czasu odpowiedzi HTTP.
    private WeatherForecast[]? forecasts;

    // Pobranie danych raz przy starcie komponentu.
    protected override async Task OnInitializedAsync()
    {
        // GET sample-data/weather.json i deserializacja do tablicy.
        forecasts = await Http.GetFromJsonAsync<WeatherForecast[]>("sample-data/weather.json");
    }

    // Model zgodny z polami w pliku JSON.
    public class WeatherForecast
    {
        public DateOnly Date { get; set; }

        public int TemperatureC { get; set; }

        public string? Summary { get; set; }

        // Fahrenheit wyliczony z Celsjusza.
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
