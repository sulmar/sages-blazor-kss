@using static Training.Blazor.Components.Pages.ProductList

<table>

    @HeaderTemplate

    <tbody>
        @foreach (var product in Products)
        {
            @ItemTemplate(product)
        }
    </tbody>

    @FooterTemplate

</table>


@code {

    [Parameter, EditorRequired]
    public required IReadOnlyList<ProductListItem> Products { get; set; }

    [Parameter]
    public RenderFragment? HeaderTemplate { get; set; }

    [Parameter, EditorRequired]
    public required RenderFragment<ProductListItem> ItemTemplate { get; set; }

    [Parameter]
    public RenderFragment? FooterTemplate { get; set; }

}
