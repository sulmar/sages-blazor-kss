@page "/counter"
@using Microsoft.Extensions.Caching.Distributed
@using Training.Blazor.Services
@inject IDistributedCache Cache
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>


<button class="btn btn-danger" @onclick="ClearCount">Clear</button>



@code {
    private int currentCount = 0;

    protected override bool ShouldRender()
    {
        return currentCount % 2 == 0;
    }


    private async Task IncrementCount()
    {
        currentCount++;

        await Cache.SetRecordAsync<int>(RedisKeys.GetCurrentKey("marcin"), currentCount);
    }

    private async Task ClearCount()
    {
        currentCount = 0;

        await Cache.RemoveAsync(RedisKeys.GetCurrentKey("marcin"));
    }

    protected override async Task OnInitializedAsync()
    {
        currentCount = await Cache.GetRecordAsync<int>(RedisKeys.GetCurrentKey("marcin"));

    }
}
