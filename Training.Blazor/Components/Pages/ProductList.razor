@page "/product-list"
@page "/products"
@inject IProductService ProductService

<PageTitle>Products</PageTitle>

<h1>Products</h1>

<Repeater Items="@products" Context="product">
    <HeaderTemplate>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
    </HeaderTemplate>

    <ItemTemplate>
        <tr>
            <td>@product.Id</td>
            <td>@product.Name</td>
            <td>@product.Price.ToString("C")</td>
            <td>
                <a href="/ProductDetails?Id=@product.Id" class="btn btn-primary">Podgląd</a>                
                <a href="/products/@product.Id/edit" class="btn btn-secondary">Edycja</a>
            </td>

        </tr>
    </ItemTemplate>

    <FooterTemplate>

    </FooterTemplate>
</Repeater>

@code {

    private IReadOnlyList<ProductListItem> products;

    // [Inject]
    // private ProductService ProductService { get; set; }

    // ekwiwalent: @inject ProductService ProductService

    // Page_Load
    protected override void OnInitialized()
    {
        products = ProductService.GetAll();
    }

}