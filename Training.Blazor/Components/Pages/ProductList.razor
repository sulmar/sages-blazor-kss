@page "/product-list"
@page "/products"
@using Training.Blazor.Components.Shared

<PageTitle>Products</PageTitle>

<h1>Products</h1>

<Repeater Items="@products" Context="product">
    <HeaderTemplate>        
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
            </tr>
        </thead>
    </HeaderTemplate>

    <ItemTemplate>
        <tr>
            <td>@product.Id</td>
            <td>@product.Name</td>
            <td>@product.Price.ToString("C")</td>
        </tr>
    </ItemTemplate>

    <FooterTemplate>
        
    </FooterTemplate>
</Repeater>

@code {

    // Page_Load
    protected override void OnInitialized()
    {
        products = GetProducts();
    }

}