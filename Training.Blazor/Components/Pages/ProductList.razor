@page "/product-list"
@page "/products"

<PageTitle>Products</PageTitle>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var product in products)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

@code {

    // Page_Load
    protected override void OnInitialized()
    {
        products = GetProducts();
    }

}